POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=imageshield
POSTGRES_HOST=postgres          # "postgres" in Docker; "localhost" for native dev
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=imageshield
MINIO_SECURE=false

MODEL_NAME=Falconsai/nsfw_image_detection
MODEL_VERSION=falconsai-vit-1
REVIEW_LOW=0.30
REVIEW_HIGH=0.80

# --- host-side published ports -------------------------------------------
# Only affect what Docker exposes on your machine; containers always reach
# each other on the standard internal ports. Override in your local .env if
# something already owns one (a natively installed Postgres on 5432 is the
# usual culprit).
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
MINIO_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001
API_PUBLISHED_PORT=8000
