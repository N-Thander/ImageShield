# ---------------------------------------------------------------------------
# ImageShield frontend — public runtime configuration.
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at BUILD time,
# so these must be correct when `next build` runs (locally, or as Docker build
# args — see frontend/Dockerfile). They are read by the browser, which means
# they must resolve from YOUR machine, not from inside the compose network:
# use localhost here, never the compose service names.
# ---------------------------------------------------------------------------

# FastAPI base URL. Used for GET /stats, /services/{key}, /ingestion, /benchmarks.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL. The live feed connects to ${NEXT_PUBLIC_WS_URL}/live.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Grafana base URL, embedded in an iframe on /grafana.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
